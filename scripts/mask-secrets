#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["detect-secrets==1.5.0"]
# ///
"""Mask secrets found by detect-secrets. Usage: cat file | mask-secrets."""

import re
import sys
import tempfile

from detect_secrets.core.scan import scan_file
from detect_secrets.settings import default_settings

text = sys.stdin.read()
# why: detect-secrets flags only the BEGIN line of a PEM key; mask the
# whole multiline block so the base64 body does not leak.
text = re.sub(
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
    "[REDACTED]",
    text,
    flags=re.DOTALL,
)
# why: scan_file applies false-positive filters;
# scan_line (adhoc mode) flags any word as entropy.
with tempfile.NamedTemporaryFile("w", suffix=".txt") as tmp:
    tmp.write(text)
    tmp.flush()
    with default_settings():
        secrets = {s.secret_value for s in scan_file(tmp.name) if s.secret_value}

# why: some detectors report only a capture group (e.g. "ghp" of a GitHub
# token), so mask the whole surrounding word.
WORD = r"[^\s'\"=:,;`]*"
for secret in sorted(secrets, key=len, reverse=True):
    text = re.sub(WORD + re.escape(secret) + WORD, "[REDACTED]", text)
sys.stdout.write(text)
