{
  "mcpServers": {
    "aipp:figma-console": {
      "command": "npx",
      "args": ["-y", "figma-console-mcp@latest"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${MCP_FIGMA_ACCESS_TOKEN:-add-value-to-env-vars}",
        "ENABLE_MCP_APPS": "true"
      }
    },
    "aipp:krita": {
      "command": "python3",
      "args": ["${HOME}/develop/public/krita-mcp/mcp_server.py"]
    },
    "aipp:vrep": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/vrep-mcp.git",
        "vrep-mcp"
      ],
      "env": {
        "VREP_DATA_DIR": "${MCP_VREP_DATA_DIR:-add-value-to-env-vars}"
      },
      "type": "stdio"
    },
    "aipp:notion": {
      "url": "https://mcp.notion.com/mcp",
      "type": "http"
    },
    "aipp:ssh-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "ssh-mcp@latest",
        "--host=${SSH_MCP_HOST:-add-value-to-env-vars}",
        "--user=${SSH_MCP_USER:-add-value-to-env-vars}",
        "--port=${SSH_MCP_PORT:-add-value-to-env-vars}"
      ],
      "env": {
        "SSH_MCP_PASSWORD": "${SSH_MCP_PASSWORD:-add-value-to-env-vars}"
      }
    },
    "aipp:omniroute": {
      "url": "http://localhost:20128/api/mcp/stream",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${OMNIROUTE_ADMIN_TOKEN:-add-value-to-env-vars}"
      }
    },
    "aipp:figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    },
    "aipp:github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT_TOKEN:-add-value-to-env-vars}"
      }
    },
    "aipp:atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "aipp:mcp-manager": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/mcp-manager.git",
        "mcp-manager",
        "--config",
        "${HOME}/develop/personal/mcp-manager/backends.json",
        "--catalog",
        "${HOME}/develop/personal/mcp-manager/catalog.json",
        "--transport",
        "stdio"
      ],
      "type": "stdio"
    },
    "aipp:postgresql": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/custom-mcps",
        "postgresql-mcp"
      ],
      "env": {
        "POSTGRES_URL": "${MCP_POSTGRES_URL:-add-value-to-env-vars}"
      }
    },
    "aipp:mysql": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/custom-mcps",
        "mysql-mcp"
      ],
      "env": {
        "MYSQL_URL": "${MCP_MYSQL_URL:-add-value-to-env-vars}"
      }
    },
    "aipp:mongodb": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/custom-mcps",
        "mongodb-mcp"
      ],
      "env": {
        "MONGODB_URL": "${MCP_MONGODB_URL:-add-value-to-env-vars}",
        "MONGODB_DATABASE": "${MCP_MONGODB_DATABASE:-add-value-to-env-vars}"
      }
    },
    "aipp:sqlite": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/custom-mcps",
        "sqlite-mcp"
      ],
      "env": {
        "SQLITEDB_PATH": "${MCP_SQLITEDB_PATH:-add-value-to-env-vars}"
      }
    },
    "aipp:skill-loader": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/AI-pair-programming.git#subdirectory=src",
        "skill-loader-mcp"
      ]
    },
    "aipp:keycloak": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Ronnasayd/keycloak-mcp-server",
        "keycloak-mcp-server"
      ],
      "env": {
        "MCP_KEYCLOAK_BASE_URL": "${MCP_KEYCLOAK_BASE_URL:-http://localhost:8080}",
        "MCP_KEYCLOAK_AUTH_METHOD": "${MCP_KEYCLOAK_AUTH_METHOD:-client_credentials}",
        "MCP_KEYCLOAK_CLIENT_ID": "${MCP_KEYCLOAK_CLIENT_ID:-add-value-to-env-vars}",
        "MCP_KEYCLOAK_CLIENT_SECRET": "${MCP_KEYCLOAK_CLIENT_SECRET:-add-value-to-env-vars}",
        "MCP_KEYCLOAK_ADMIN_USERNAME": "${MCP_KEYCLOAK_ADMIN_USERNAME:-add-value-to-env-vars}",
        "MCP_KEYCLOAK_ADMIN_PASSWORD": "${MCP_KEYCLOAK_ADMIN_PASSWORD:-add-value-to-env-vars}"
      }
    },
    "aipp:context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY:-add-value-to-env-vars}"
      ]
    },
    "aipp:burp": {
      "command": "java",
      "args": [
        "-jar",
        "/home/ronnas/mcp-proxy.jar",
        "--sse-url",
        "http://127.0.0.1:9876/"
      ]
    },
    "aipp:gcloud": {
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp"]
    }
  }
}
