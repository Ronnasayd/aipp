{
  "hook": "scripts/protect_files.py",
  "mode": "exit_code",
  "description": "Eval cases for protect_files.py (PreToolUse file/command protection hook)",
  "cases": [
    {
      "name": "read_env_file_denied",
      "tool_name": "Read",
      "tool_input": {
        "file_path": "$AI_PROJECT_ROOT_DIR/.env"
      },
      "expect": "deny",
      "expect_pattern": ".env"
    },
    {
      "name": "read_normal_file_allowed",
      "tool_name": "Read",
      "tool_input": {
        "file_path": "$AI_PROJECT_ROOT_DIR/hooks/scripts/protect_files.py"
      },
      "expect": "allow"
    },
    {
      "name": "write_ssh_key_denied",
      "tool_name": "Write",
      "tool_input": {
        "file_path": "$HOME/.ssh/id_rsa",
        "content": "x"
      },
      "expect": "deny",
      "expect_pattern": "id_rsa"
    },
    {
      "name": "edit_claude_settings_denied",
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "$AI_PROJECT_ROOT_DIR/.claude/settings.json"
