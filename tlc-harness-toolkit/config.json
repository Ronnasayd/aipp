{
  "$schema": "https://unpkg.com/@tech-leads-club/harness-toolkit@0.16/schema.json",
  "version": 1,
  "codePaths": [
    "src",
    "app",
    "apps",
    "lib",
    "libs",
    "packages",
    "pkg",
    "cmd",
    "internal",
    "server",
    "client",
    "backend",
    "frontend",
    "api",
    "services",
    "components",
    "pages",
    "hooks",
    "scripts",
    "tools",
    "utils",
    "tests",
    "test",
    "__tests__",
    "e2e"
  ],
  "mode": "solo",
  "grind": {
    "enabled": true,
    "lintCommand": [
      "sh",
      "-c",
      "[ \"$SKIP_LINT\" = 1 ] || exec uv run .claude/hooks/scripts/lint_changed.py"
    ],
    "testCommand": [
      "sh",
      "-c",
      "[ \"$SKIP_TESTS\" = 1 ] || exec uv run .claude/hooks/scripts/test_changed.py"
    ],
    "maxLoops": 5
  },
  "comments": {
    "enabled": true,
    "mode": "declared",
    "onViolation": "off"
  },
  "duplication": {
    "enabled": true,
    "minRun": 15
  },
  "supplyChain": {
    "enabled": true
  },
  "shipGate": {
    "enabled": true,
    "emptyDiffAntiShip": true
  },
  "rules": {
    "enabled": true
  },
  "subagents": {
    "enforceAllowlist": false,
    "requireModel": true,
    "blockMode": "deny",
    "blockParentFast": false,
    "readOnlyTypes": ["explore"]
  },
  "obs": {
    "globalSpool": false,
    "retentionDays": 14
  },
  "shell": {
    "catastrophicAsk": true,
    "stallDetection": true,
    "stallRepeatThreshold": 5
  },
  "docs": {
    "command": null,
    "severity": "warn"
  },
  "intelligence": {
    "gapFeedback": true,
    "failureClassification": true,
    "progressiveHandoff": true,
    "progressiveContext": true,
    "autopilot": true,
    "budgetContinue": false,
    "budgetContinueAfterLoops": 3,
    "lessons": {
      "enabled": true,
      "maxInjectSession": 5,
      "maxInjectRetry": 8,
      "maxCharsSession": 900,
      "maxCharsRetry": 1400,
      "promoteHitCount": 2,
      "decayLambda": 0.02,
      "projectBoost": 1.5,
      "gardenOnSessionEnd": true
    }
  },
  "untrustedContent": {
    "enabled": true,
    "mode": "frame"
  },
  "secrets": {
    "redactOutput": true
  }
}
